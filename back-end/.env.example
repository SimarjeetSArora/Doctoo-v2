# Copy this file to .env and adjust values.
ENVIRONMENT=development
# Matches the credentials in ../docker-compose.yml
DATABASE_URL=postgresql+asyncpg://doctoo:doctoo_dev_password@localhost:5432/doctoo
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Where the React app runs (used for links inside emails)
FRONTEND_URL=http://localhost:5173
# "console" = print emails in the backend terminal instead of sending them
EMAIL_BACKEND=console
