# Copy this file to .env and adjust values.
ENVIRONMENT=development
# Matches the credentials in ../docker-compose.yml
DATABASE_URL=postgresql+asyncpg://doctoo:doctoo_dev_password@localhost:5432/doctoo
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Where the React app runs (used for links inside emails)
FRONTEND_URL=http://localhost:5173

# ---------- Email ----------
# "smtp" = send via the SMTP server below; "console" = just print emails in the backend terminal
EMAIL_BACKEND=smtp
EMAIL_FROM_ADDRESS=no-reply@doctoo.local
EMAIL_FROM_NAME=Doctoo

# Development: Mailpit from docker-compose catches all emails -> open http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=none

# Production examples (replace the block above):
#   Gmail / Google Workspace (needs an App Password, ~500 emails/day):
#     SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURITY=starttls
#     SMTP_USERNAME=you@gmail.com  SMTP_PASSWORD=<16-char app password, no spaces>
#     EMAIL_FROM_ADDRESS=   (leave empty: Gmail sends as SMTP_USERNAME)
#   Zoho Mail (India):   SMTP_HOST=smtp.zoho.in  SMTP_PORT=465  SMTP_SECURITY=ssl
#   Brevo:               SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_SECURITY=starttls
#   Amazon SES (Mumbai): SMTP_HOST=email-smtp.ap-south-1.amazonaws.com  SMTP_PORT=587  SMTP_SECURITY=starttls
# EMAIL_FROM_ADDRESS must be an address/domain your provider allows you to send from.

# ---------- SMS ----------
# "mailpit" = show texts in the dev inbox (http://localhost:8025); "console" = print them;
# "msg91" = send real SMS through MSG91 (see README "SMS with MSG91" for DLT setup)
SMS_BACKEND=mailpit
MSG91_AUTH_KEY=
MSG91_LOGIN_TEMPLATE_ID=
MSG91_INVITATION_TEMPLATE_ID=
# Let MSG91 shorten invitation links (DLT allows max 30 characters per variable)
MSG91_SHORT_URLS=true

# ---------- WhatsApp (MSG91) ----------
# "mailpit" = show messages in the dev inbox; "console" = print them; "msg91" = real WhatsApp
WHATSAPP_BACKEND=mailpit
# Your WhatsApp Business number connected in MSG91, with country code, no + (e.g. 919876543210)
MSG91_WHATSAPP_NUMBER=
# Names of your APPROVED WhatsApp templates in MSG91 (see README "WhatsApp with MSG91")
MSG91_WHATSAPP_LOGIN_TEMPLATE=doctoo_login_code
MSG91_WHATSAPP_INVITATION_TEMPLATE=doctoo_invitation
# How invitations to a mobile number are sent: whatsapp or sms
PHONE_INVITE_VIA=whatsapp
